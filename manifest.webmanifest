{
  "id": "./",
  "name": "מאמן ידע – מבחני כושר",
  "short_name": "מאמן ידע",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0b0f17",
  "theme_color": "#0b0f17",
  "description": "תרגול ומבחנים למדריכי כושר: 160+ שאלות באנטומיה, פיזיולוגיה, טכניקה, תכנון אימונים, TRX, תזונה ובטיחות. אתגר יומי, מבחן מהירות, סימולציית מבחן וכרטיסיות.",
  "categories": [
    "education",
    "health",
    "fitness"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
